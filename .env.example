# Copy to .env.local for `npm run playground`. Never commit the real key.

# Secret team key from the Neocortex dashboard (sk_...). Stays on the server.
NEOCORTEX_API_KEY=

# Defaults to https://api.neocortex.link/v3. Point at a local dev server to test against it,
# e.g. http://localhost:3000/api/v3
NEOCORTEX_BASE_URL=

# Comma-separated character IDs the playground's browser is allowed to talk to.
NEOCORTEX_CHARACTERS=

# Optional: a question set for the Quiz tab (Team plan).
NEOCORTEX_QUESTION_SET=

PLAYGROUND_PORT=5173
