# Your secret team key from the Neocortex dashboard. It stays on this server.
NEOCORTEX_API_KEY=

# The character visitors talk to.
NEOCORTEX_CHARACTER_ID=

# Optional: sign visitor cookies with a fixed secret so they survive restarts.
SESSION_SECRET=

# Optional: point at another API, e.g. a local dev server at http://localhost:3000/api/v3
NEOCORTEX_BASE_URL=

PORT=3100
